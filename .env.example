# Copy to .env and fill in. Never commit .env.
# Values come from your Supabase project's API Keys page.

PORT=4000
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co

# Public key. Used by the API to sign users in.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Secret key. Bypasses Row Level Security. Server only.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Google Maps JavaScript API key for the browser map. It ships in the page by
# design, so restrict it to your site's domains and the Maps APIs in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=your-browser-key

# Optional phone OTP delivery. Supabase's Send SMS Hook calls the API with this
# signing secret (format: v1,whsec_...). Leave the SMS values empty to keep phone
# numbers unverified until an admin confirms them.
SEND_SMS_HOOK_SECRET=
SMS_PROVIDER=
SMS_API_KEY=
