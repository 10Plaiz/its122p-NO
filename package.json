{
  "name": "kamoti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KAMOTI full-stack public infrastructure reporting application",
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "tsx watch src/server/server.ts",
    "dev:web": "vite",
    "fixture": "tsx scripts/fixture/seed.ts",
    "seed:generate": "bun scripts/demo/seed.ts generate",
    "seed:plan": "bun scripts/demo/seed.ts plan",
    "seed:apply": "bun scripts/demo/seed.ts apply",
    "seed:verify": "bun scripts/demo/seed.ts verify",
    "seed:assets": "bun scripts/demo/render-assets.ts",
    "test": "bun test",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report",
    "test:cleanup": "tsx tests/browser/cleanup.ts",
    "test:security": "tsx tests/integration/security.ts",
    "test:submission-limits": "bun tests/integration/submission-limits.ts",
    "test:submission-browser": "bun tests/integration/submission-browser.ts",
    "test:smoke": "bun scripts/smoke/verify-deployment.ts",
    "typecheck": "bun run typecheck:api && bun run typecheck:web && bun run typecheck:deploy && bun run typecheck:test",
    "typecheck:api": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:deploy": "tsc --noEmit -p tsconfig.deploy.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "build": "bun run build:api && bun run build:web",
    "build:api": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vis.gl/react-google-maps": "^1.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "multer": "^2.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "standardwebhooks": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "supabase": "^2.117.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
